{
  "manifest_version": 3,
  "name": "Explain",
  "version": "1.0.0",
  "description": "Explain the word or passage you select on a page.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://generativelanguage.googleapis.com/*"],
  "action": {
    "default_title": "Explain",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src https://generativelanguage.googleapis.com"
  }
}
